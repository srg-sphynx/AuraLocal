<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Aura Local</string>
	<key>CFBundleExecutable</key>
	<string>AuraLocal</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.aura.local</string>
	<key>CFBundleName</key>
	<string>Aura Local</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>4.0.2</string>
	<key>CFBundleVersion</key>
	<string>4.0.2</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Local-first RAG chat for Ollama &amp; LM Studio.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<true/>
	<key>NSSupportsSuddenTermination</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<!-- Update-channel identity is NOT stored in source control. `build_app.sh`
	     injects the real SUFeedURL / SUPublicEDKey from the untracked
	     Packaging/release.env at bundle time (see Packaging/release.env.example).
	     A build without that file ships with the placeholders stripped and
	     automatic checks off, so it never polls another party's feed. -->
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUFeedURL</key>
	<string>__SU_FEED_URL__</string>
	<key>SUPublicEDKey</key>
	<string>__SU_PUBLIC_ED_KEY__</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
