<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Aura Local</string>
	<key>CFBundleExecutable</key>
	<string>AuraLocal</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.aura.local</string>
	<key>CFBundleName</key>
	<string>Aura Local</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>3.2.0</string>
	<key>CFBundleVersion</key>
	<string>3.2.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Local-first RAG chat for Ollama &amp; LM Studio.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<true/>
	<key>NSSupportsSuddenTermination</key>
	<true/>
	<!-- ▼ Sparkle auto-update configuration ▼ -->
	<!-- Appcast the app polls for new versions. Host this file anywhere static
	     (GitHub Pages, S3, any web server). See docs/UPDATES.md. -->
	<key>SUFeedURL</key>
	<string>https://srg-sphynx.github.io/AuraLocal/appcast.xml</string>
	<!-- EdDSA (ed25519) PUBLIC key. Generate the keypair once with Sparkle's
	     `generate_keys` tool; the private key stays in your Keychain and the
	     public key goes here. Updates whose signature doesn't match are rejected.
	     Replace the placeholder below before publishing your first update. -->
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_YOUR_SPARKLE_ED25519_PUBLIC_KEY</string>
	<!-- Check for updates automatically in the background. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Seconds between background checks (86400 = once per day). -->
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Ask before installing rather than updating silently. -->
	<key>SUAutomaticallyUpdate</key>
	<false/>
</dict>
</plist>
