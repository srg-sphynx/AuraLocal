# Aura Local — release channel configuration (TEMPLATE)
#
# Copy to `Packaging/release.env` and fill in your own values:
#
#     cp Packaging/release.env.example Packaging/release.env
#
# `Packaging/release.env` is gitignored and MUST NOT be committed. It holds the
# identity of *your* update channel: the appcast you publish to and the public
# half of the EdDSA keypair that signs your releases. Keeping it out of source
# control means a clone of this repository cannot build an app that polls or
# impersonates the official Aura Local update feed.
#
# Without this file, `build_app.sh` still produces a working .app — it simply
# strips the update-feed keys and ships with automatic checks disabled.

# ---------------------------------------------------------------------------
# Sparkle update feed
# ---------------------------------------------------------------------------

# The appcast URL the shipped app polls for new versions (Info.plist SUFeedURL).
SU_FEED_URL="https://example.github.io/YourApp/appcast.xml"

# Base64 EdDSA *public* key printed by Sparkle's `generate_keys`
# (Info.plist SUPublicEDKey). The matching PRIVATE key lives only in your login
# Keychain — never in this file and never in the repository.
SU_PUBLIC_ED_KEY="REPLACE_WITH_YOUR_SPARKLE_ED25519_PUBLIC_KEY"

# ---------------------------------------------------------------------------
# Publishing target (used by release_update.sh only)
# ---------------------------------------------------------------------------

# owner/repo that receives the GitHub Release and hosts the gh-pages appcast.
RELEASE_REPO="your-org/YourApp"

# Commit identity used for the automated appcast commit on gh-pages.
# Use a role address or a GitHub noreply address — not a personal inbox.
RELEASE_GIT_NAME="your-release-bot"
RELEASE_GIT_EMAIL="release-bot@users.noreply.github.com"
