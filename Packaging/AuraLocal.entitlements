<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Non-sandboxed local app: full access to user-selected vaults and the
         localhost inference endpoints. Security-scoped bookmarks are still used
         to persist folder access cleanly across launches. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Allow loading the embedded Sparkle.framework. Under the hardened runtime,
         Library Validation otherwise refuses any framework whose signing identity
         doesn't match the main executable's — which includes our ad-hoc-signed
         (Team-ID-less) Sparkle bundle. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
